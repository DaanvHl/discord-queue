# Copy this file to `.env` and fill in your own values.
# Never commit the real .env — it holds your bot token.

DISCORD_TOKEN=your-bot-token-here
GUILD_ID=your-server-id

# Where queue commands are allowed. Use QUEUE_CHANNEL_ID for a single channel,
# and/or QUEUE_CHANNEL_IDS for several (comma-separated). They're merged.
QUEUE_CHANNEL_ID=your-queue-channel-id
# QUEUE_CHANNEL_IDS=channel-id-1,channel-id-2,channel-id-3

# Optional: channel where confirmed match results are logged. Leave unset to disable.
# RESULTS_CHANNEL_ID=your-results-channel-id

# Optional: a role allowed to use admin commands (/clear, /remove) alongside admins.
# ORGANIZER_ROLE_ID=your-organizer-role-id

# Optional. Local default is players.db. On a host, point this at a persistent
# volume so the database survives redeploys, e.g. /data/players.db
# DB_PATH=/data/players.db
