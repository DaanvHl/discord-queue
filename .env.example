# Copy this file to `.env` and fill in your own values.
# Never commit the real .env — it holds your bot token.

DISCORD_TOKEN=your-bot-token-here
GUILD_ID=your-server-id
QUEUE_CHANNEL_ID=your-queue-channel-id

# Optional. Local default is players.db. On a host, point this at a persistent
# volume so the database survives redeploys, e.g. /data/players.db
# DB_PATH=/data/players.db
